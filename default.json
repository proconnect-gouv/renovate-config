{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":maintainLockFilesMonthly",
    ":prHourlyLimit4",
    ":timezone(Europe/Paris)",
    "customManagers:dockerfileVersions",
    "helpers:pinGitHubActionDigests",
    "schedule:weekly"
  ],
  "commitMessageAction": "⬆️ Bump",
  "commitMessageExtra": "from {{{currentVersion}}} to {{{newVersion}}}",
  "dependencyDashboardAutoclose": true,
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "commitMessageAction": "⬆️ Lock file maintenance"
  },
  "minimumReleaseAge": "7 days",
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "commitMessageTopic": "{{{depName}}}",
      "matchPackageNames": ["*"]
    },
    {
      "commitMessageExtra": "from {{{currentDigestShort}}} to {{{newDigestShort}}}",
      "matchUpdateTypes": ["digest"]
    },
    {
      "groupName": "proconnect-gouv",
      "matchPackageNames": ["@proconnect-gouv/**"]
    },
    {
      "matchPackageNames": [
        "@proconnect-gouv/**",
        "ghcr.io/proconnect-gouv/**"
      ],
      "minimumReleaseAge": null
    },
    {
      "enabled": false,
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major", "minor"]
    },
    {
      "matchManagers": ["bun", "npm"],
      "rangeStrategy": "bump"
    }
  ],
  "postUpdateOptions": ["npmDedupe"],
  "semanticCommits": "disabled",
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"]
  }
}
